# Salin ke .env lalu isi. Jangan commit .env.

# --- Aplikasi ---
ENVIRONMENT=local
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
DB_POOL_SIZE=10

# --- Model AI (endpoint OpenAI-compatible; BASE_URL kosong = OpenAI) ---
BASE_URL=
API_KEY=
CHAT_MODEL=gpt-5.5
EMBED_MODEL=text-embedding-3-large

# --- Retrieval ---
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_N=5
RRF_K=60
RRF_WEIGHT_VECTOR=1.0
RRF_WEIGHT_FULLTEXT=1.0
VECTOR_THRESHOLD=0.35
LEXICAL_THRESHOLD=0.05

# --- Ingestion ---
CHUNK_SIZE=700
CHUNK_OVERLAP=105

# --- Penyimpanan dokumen (local | s3) ---
STORAGE_BACKEND=s3
STORAGE_DIR=storage/documents

# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ADDRESSING_STYLE=auto
S3_CHECKSUM_COMPAT=true
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=900

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot

# --- Keamanan ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
ADMIN_TOKEN_TTL_MINUTES=480
RATE_LIMIT_PER_SESSION=20/minute
RATE_LIMIT_PER_IP=60/minute
KILL_SWITCH_ENABLED=false

# --- Dashboard admin ---
# Asal peramban yang boleh memanggil API, dipisah koma.
# Kosong + ENVIRONMENT=local = semua asal diizinkan (admin/ di localhost:3000).
CORS_ORIGINS=
MAX_UPLOAD_MB=50
TIMEZONE=Asia/Jakarta
