# Salin ke .env lalu isi. Jangan commit .env. Penjelasan lengkap: app/config.py.

# --- Aplikasi ---
ENVIRONMENT=local
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
DB_POOL_SIZE=10

# --- Model AI (endpoint OpenAI-compatible; BASE_URL kosong = OpenAI) ---
# EMBED_PROVIDER: api (lewat BASE_URL) | local. Ganti model embedding = re-index.
# LLM_STREAM_USAGE: matikan hanya bila gateway menolak stream_options.
BASE_URL=
API_KEY=
CHAT_MODEL=cx/gpt-6-luna
EMBED_MODEL=text-embedding-3-large
EMBED_PROVIDER=api
LLM_STREAM_USAGE=true
# Detik per permintaan LLM (juga jeda antar potongan stream), dan jumlah retry.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# --- Retrieval ---
# Nilai awal; superadmin dapat menimpanya (juga CHUNK_* dan CHAT_DAILY_LIMIT)
# dari halaman Konfigurasi dashboard, tanpa restart.
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_N=5
# Paling banyak berapa chunk satu dokumen di antara RETRIEVAL_TOP_N, supaya
# satu dokumen tidak menutup dokumen lain yang memuat jawabannya. 0 = tanpa
# batas. Hanya lewat .env.
RETRIEVAL_MAX_PER_DOCUMENT=4
# Chunk teratas yang diberi potongan sesudahnya (prosedur terbelah antar
# halaman). Hanya lewat .env, tidak ada di halaman Konfigurasi.
RETRIEVAL_NEIGHBORS=5
# Paling banyak berapa dokumen yang daftar babnya ikut ke konteks, bila
# hasilnya tersebar di beberapa bab ("jenis beasiswa apa saja?"). 0 = mati.
# Hanya lewat .env.
RETRIEVAL_OUTLINE=2
RRF_K=60
RRF_WEIGHT_VECTOR=1.0
RRF_WEIGHT_FULLTEXT=1.0
VECTOR_THRESHOLD=0.35
LEXICAL_THRESHOLD=0.05

# --- Reranker (setelah RRF, sebelum ambang) ---
# Mati: urutan RRF langsung dipakai. Menyalakan = RERANK_ENABLED=true ditambah
# RERANK_BASE_URL, RERANK_API_KEY, RERANK_MODEL (lihat docs/rerank.md).
RERANK_ENABLED=false

# --- Gerbang JEV (memilah pesan, paralel dengan pencarian) ---
# JEV_URL kosong = <BASE_URL>/systemone; JEV_API_KEY kosong = API_KEY.
# JEV ditunggu selama pencarian berjalan + JEV_GRACE_SECONDS; JEV_TIMEOUT_SECONDS
# hanya batas keras bila pencarian juga lambat.
# JEV_ENABLED=false tetap aman: saringan aturan (app/rag/rule_gate.py) dan penanda
# [DI_LUAR_TOPIK] dari LLM penjawab menggantikan vonisnya tanpa biaya per pesan.
# Ambang dikalibrasi 2026-09-29 (jev.md): 0,7 untuk smalltalk/nonsense/malicious,
# 0,9 untuk out_of_scope. JEV_NONSENSE_THRESHOLD kosong = JEV_BLOCK_THRESHOLD;
# diisi hanya untuk Laya hasil latih (laya.md), yang memberi nonsense sampai 0,81
# pada pertanyaan akademik yang sangat pendek. Untuk Laya (skala answer_confidence,
# set kalibrasi laya.md A3, 2026-10-08): JEV_OUT_OF_SCOPE_THRESHOLD=0.7 dan
# JEV_NONSENSE_THRESHOLD=0.95.
JEV_ENABLED=false
JEV_URL=
JEV_API_KEY=
JEV_MODEL=openrouter/typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=10
JEV_GRACE_SECONDS=1.5
JEV_BLOCK_THRESHOLD=0.7
JEV_OUT_OF_SCOPE_THRESHOLD=0.9
JEV_NONSENSE_THRESHOLD=

# --- Ingestion ---
# Juga dapat disetel dari halaman Konfigurasi; berlaku untuk dokumen berikutnya.
CHUNK_SIZE=900
CHUNK_OVERLAP=105

# --- Penyimpanan dokumen ---
# STORAGE_BACKEND: local (pakai STORAGE_DIR) | s3.
# Cloudflare R2: S3_ENDPOINT_URL https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_BACKEND=s3
STORAGE_DIR=storage/documents
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ADDRESSING_STYLE=auto
S3_CHECKSUM_COMPAT=true
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=900

# --- LangSmith (FR-8) ---
# Tracing menyala bila LANGSMITH_TRACING true DAN LANGSMITH_API_KEY terisi.
# LANGSMITH_ENDPOINT diubah hanya untuk region EU atau instans self-hosted.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot

# --- Log aplikasi (SQLite, dibaca halaman Log dashboard) ---
# Di Docker, mount direktori LOG_DB_PATH sebagai volume.
LOG_DB_PATH=log/app.db
LOG_RETENTION_DAYS=7
LOG_LEVEL=INFO
# Rekam teks pertanyaan/jawaban, NIM, dan input/output tiap node + panggilan
# LLM/tool untuk tab Graf. Pertanyaan sensitif (FR-7) tetap disamarkan.
# false = hanya metrik dan log (tanpa teks mahasiswa).
LOG_NODE_IO=true

# --- Keamanan ---
# ADMIN_JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
ADMIN_TOKEN_TTL_MINUTES=480
KILL_SWITCH_ENABLED=false

# --- Batas pemakaian endpoint mahasiswa ---
# RATE_LIMIT_*: N/second|minute|hour|day, 0 = mati. CHAT_DAILY_LIMIT lewat = kill switch.
# CLIENT_IP_HEADER: X-Forwarded-For di balik Caddy, CF-Connecting-IP di balik Cloudflare.
RATE_LIMIT_PER_SESSION=20/minute
RATE_LIMIT_PER_IP=60/minute
RATE_LIMIT_PER_EMBED_SITE=60/minute
CLIENT_IP_HEADER=X-Forwarded-For
CHAT_DAILY_LIMIT=3000

# --- Dashboard admin dan portal ---
# CORS_ORIGINS: asal dashboard/portal dipisah koma; kosong + local = semua asal.
# PORTAL_URL: alamat portal untuk kode sematan; kosong + local = localhost:3001.
CORS_ORIGINS=
PORTAL_URL=
MAX_UPLOAD_MB=50
TIMEZONE=Asia/Jakarta

# --- Layanan akademik SADS (tool-calling; docs/tool-call.md) ---
# TOOLS_ENABLED=false aman: jalur tool belum wajib. Auth SADS = header `secret`.
TOOLS_ENABLED=false
TOOLS_MAX_ROUNDS=2
SADS_BASE_URL=https://sads.instiki.ac.id
SADS_API_SECRET=
SADS_TIMEOUT_SECONDS=10
