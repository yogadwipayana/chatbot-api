# Salin ke .env lalu isi. Jangan commit .env.

# --- Aplikasi ---
ENVIRONMENT=local
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
DB_POOL_SIZE=10

# --- Model AI (endpoint OpenAI-compatible; BASE_URL kosong = OpenAI) ---
BASE_URL=
API_KEY=
CHAT_MODEL=gpt-5.5
EMBED_MODEL=text-embedding-3-large
# api = EMBED_MODEL lewat BASE_URL. local = sentence-transformers di server ini
# (uv sync --extra local), mis. EMBED_MODEL=intfloat/multilingual-e5-small.
# Model e5 lewat api juga didukung: awalan query/passage dan padding dipasang
# otomatis. Ganti model = re-index + kalibrasi ulang ambang (docs/e5.md).
# Mengganti model/provider WAJIB diikuti: python -m scripts.reindex_embeddings
EMBED_PROVIDER=api
# Jumlah token ikut dikirim saat jawaban dialirkan token demi token (FE-1).
# Matikan hanya bila gateway menolak `stream_options`; yang hilang cuma
# estimasi biaya AD-5, jawabannya tetap utuh.
LLM_STREAM_USAGE=true

# --- Retrieval ---
# Nilai awal saja: superadmin dapat menyetel ulang tujuh variabel di bawah
# (dan CHUNK_*) dari menu Konfigurasi dashboard, tanpa restart. Yang disetel
# dari sana disimpan di tabel `runtime_config` dan menimpa nilai di sini
# sampai dikembalikan. Lihat README "Setelan yang dapat diubah dari dashboard".
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_N=5
RRF_K=60
RRF_WEIGHT_VECTOR=1.0
RRF_WEIGHT_FULLTEXT=1.0
VECTOR_THRESHOLD=0.35
LEXICAL_THRESHOLD=0.05

# --- Reranker (setelah RRF, sebelum threshold) ---
# none | api (endpoint /rerank gaya Cohere/Jina) | local (cross-encoder,
# butuh uv sync --extra local, mis. RERANK_MODEL=BAAI/bge-reranker-v2-m3).
RERANK_PROVIDER=none
RERANK_MODEL=
# Kosong = BASE_URL / API_KEY.
RERANK_BASE_URL=
RERANK_API_KEY=
# Hasil RRF yang dinilai ulang; yang masuk konteks LLM tetap RETRIEVAL_TOP_N.
RERANK_CANDIDATES=20
# Terisi (0..1) = penolakan FR-3 memakai skor reranker, bukan skor mentah
# vector/fulltext. Kalibrasi dulu; kosong = ambang lama.
RERANK_THRESHOLD=
RERANK_TIMEOUT_SECONDS=10

# --- Gerbang JEV (typesafe/jev lewat gateway BASE_URL) ---
# Memilah pesan sebelum retrieval: academic / smalltalk / out_of_scope /
# nonsense / malicious. Galat atau timeout = pesan tetap diteruskan.
JEV_ENABLED=false
# Kosong = <BASE_URL>/systemone. Kosong = API_KEY.
JEV_URL=
JEV_API_KEY=
JEV_MODEL=openrouter/typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=3
JEV_BLOCK_THRESHOLD=0.8
JEV_OUT_OF_SCOPE_THRESHOLD=0.9

# --- Ingestion ---
# Juga dapat disetel dari menu Konfigurasi; hanya berlaku untuk dokumen yang
# diproses setelahnya.
CHUNK_SIZE=900
CHUNK_OVERLAP=105

# --- Penyimpanan dokumen (local | s3) ---
STORAGE_BACKEND=s3
STORAGE_DIR=storage/documents

# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ADDRESSING_STYLE=auto
S3_CHECKSUM_COMPAT=true
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=900

# --- LangSmith (FR-8) ---
# Tracing baru menyala bila TRACING=true DAN API_KEY terisi. Status sebenarnya
# terbaca di GET /health (tracing_enabled) dan di log saat proses start.
LANGSMITH_TRACING=true
# Ubah hanya untuk region Eropa (https://eu.api.smith.langchain.com) atau
# instans self-hosted. Kosong berarti memakai bawaan SDK.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot

# --- Log aplikasi (SQLite, dibaca halaman Log dashboard) ---
# Relatif terhadap direktori kerja. Di Docker, mount direktorinya sebagai volume.
LOG_DB_PATH=log/app.db
LOG_RETENTION_DAYS=7
LOG_LEVEL=INFO

# --- Keamanan ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
ADMIN_TOKEN_TTL_MINUTES=480
RATE_LIMIT_PER_SESSION=20/minute
RATE_LIMIT_PER_IP=60/minute
KILL_SWITCH_ENABLED=false

# --- Dashboard admin ---
# Asal peramban yang boleh memanggil API, dipisah koma, tanpa garis miring akhir.
# Wajib diisi bila dashboard/portal berada di domain lain dari API, mis.
# CORS_ORIGINS=https://admin.instiki.ac.id,https://portal.instiki.ac.id
# Kosong + ENVIRONMENT=local = semua asal diizinkan (admin/ di localhost:3000).
CORS_ORIGINS=
MAX_UPLOAD_MB=50
TIMEZONE=Asia/Jakarta
